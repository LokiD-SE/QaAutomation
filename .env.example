# Copy to .env (gitignored) - or run ./setup.sh, which can link Greybox's .env instead of copying secrets.
# Same names as Greybox, so one file serves both.
QA_COMPANY=stagingbatleap
BIZOM_WEB_URL=
BIZOM_WEB_USER=
BIZOM_WEB_PASSWORD=
BIZOM_APP_USER=
BIZOM_APP_PASSWORD=
# A login per role, user/password (spaces as underscores; n/a = this company has none):
# BIZOM_WEB_ROLE_APPROVER=
# BIZOM_APP_ROLE_DISTRIBUTOR_SALESMAN=
# Per-company values: the same names suffixed with the company in capitals, e.g. BIZOM_WEB_URL_STAGINGBATLEAP=
# Android device for app tests (adb serial); default: the first device adb lists.
# QA_DEVICE=
# QA_HEADED=1    show the browser
